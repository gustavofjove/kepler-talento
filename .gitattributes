* text=auto eol=lf

# Files consumed by Linux containers must keep LF regardless of the checkout
# platform: a CRLF shebang makes the interpreter unresolvable and the container
# exits 127.
*.sh text eol=lf
docker-entrypoint.d/* text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
