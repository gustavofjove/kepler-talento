{
  "name": "rrhh-bbdd",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación interna Kepler Talento para gestión de CVs con React, ASP.NET Core y PostgreSQL",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 4300 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:backend": "dotnet build backend/KeplerTalento.slnx",
    "build:all": "npm run build && npm run build:backend",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run --project security",
    "test:backend": "dotnet test backend/KeplerTalento.slnx --no-restore",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "security:rls": "node scripts/check-rls.js",
    "security:storage": "node scripts/check-storage-policies.js",
    "smoke:staging": "node scripts/smoke-staging.js",
    "release:gate": "node scripts/release-gate.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0",
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/nunito-sans": "^5.2.5",
    "@lexical/html": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "i18next": "^26.4.2",
    "lexical": "^0.51.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.14",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,html,css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
