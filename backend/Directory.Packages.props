<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <!--
      KTL-16 (design D1). The framework's own package for validating OIDC bearer tokens,
      maintained on the same cadence as ASP.NET Core. The alternative - hand-validating JWS
      against JWKS - would be new security-critical code for no benefit.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <!--
      KTL-32 (design D7). Phone numbers found in free CV text, across formats (+34, 0034,
      spaces, dots, foreign numbers). Apache-2.0 port of Google's libphonenumber; a hand
      regex would be the weakest extracted field.
    -->
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.40" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      KTL-32 (design D7). PDF text extraction for CV drafts; the BCL has none. Apache-2.0, pure
      managed code (namespace UglyToad.PdfPig). The alternatives are native pdfium/poppler
      wrappers or AGPL/commercial libraries.
    -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>