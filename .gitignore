appsettings.*.local.json
secrets.json

# Azure deployment secrets (live keys/passwords — never commit)
docs/azure-secrets.local.md
*.secrets.local.md

# Local file storage for preview images (Storage:Provider=Local).
# Runtime artifacts; never commit. Production uses Azure Blob; on-prem writes here.
backend/Web/App_Data/uploads/

# Per-installation JWT secret generated on first offline run (HMS-163d). Machine-local; never commit.
backend/Web/App_Data/jwt.secret

# Dev email dumps (Email:Log:WriteToDisk=true writes rendered .eml/.html here). Never commit.
backend/Web/App_Data/emails/

# Offline SPA build output (scripts/build-offline.sh copies frontend/dist here so the
# backend serves the combined app). Build artifact, rebuilt per release; never commit.
backend/Web/wwwroot/

backend/.tmp-tools/

