{
  "name": "rrhh-bbdd",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicacion interna Kepker Talento para gestion de CVs con React, Supabase y OpenSpec",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 4200 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4200",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "security:rls": "node scripts/check-rls.js",
    "security:storage": "node scripts/check-storage-policies.js",
    "smoke:staging": "node scripts/smoke-staging.js",
    "release:gate": "node scripts/release-gate.js"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/nunito-sans": "^5.2.5",
    "@supabase/supabase-js": "^2.110.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,html,css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
